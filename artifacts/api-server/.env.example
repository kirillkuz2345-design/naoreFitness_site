# Local development for the Express API server (artifacts/api-server).
# In production the API runs as Vercel serverless functions (see /api) and
# these variables are set in Vercel → Project → Settings → Environment Variables.

PORT=5000
LOG_LEVEL=info

# ---- Telegram lead delivery (the "database") ----
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456789:AA...replace-me
# Numeric chat/channel ID that receives leads (NOT the bot's own id).
# Message the bot, then read the id via:
#   https://api.telegram.org/bot<token>/getUpdates  -> "chat":{"id":...}
TELEGRAM_CHAT_ID=123456789
