{
  "compilerOptions": {
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": ["node"],
    "strict": true,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "@workspace/api-zod": ["lib/api-zod/src/index.ts"],
      "@workspace/leads": ["lib/leads/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
